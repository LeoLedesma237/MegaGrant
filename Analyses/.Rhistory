# Show the spellgroup and topography interaction for the intercept
emmip(delta_b_m1, SpellGroup ~ topography, param = "a", CIs = TRUE) +
labs(title = "Spelling Group Differences on the Intercept") +
theme_clean()
# Show the spellgroup and topography interaction for the slopes
emmip(delta_b_m1, SpellGroup ~ topography, param = "b", CIs = TRUE) +
labs(title = "Spelling Group Differences on the Instantaneous Slope") +
theme_clean()
